---
import { getCollection } from "astro:content";
import Layout from "layouts/Layout.astro";
import { Logo } from "components/Logo.jsx";
import { tagColor } from "../../utils/tagColor";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();

// JSON-LD structured data for SEO - helps search engines understand the content
// and enables rich snippets in search results (author, date, etc.)
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: {
    "@type": "Person",
    name: "Vasisht Sankar",
    url: "https://www.linkedin.com/in/vasishtsankar/",
    sameAs: [
      "https://www.linkedin.com/in/vasishtsankar/",
      "https://github.com/vsanka14",
    ],
  },
  publisher: {
    "@type": "Person",
    name: "Vasisht Sankar",
  },
  mainEntityOfPage: {
    "@type": "WebPage",
    "@id": `https://dryrun.blog/blog/${post.slug}`,
  },
};
---

<Layout
  title={post.data.title}
  description={post.data.description}
  type="article"
  publishedDate={post.data.date}
  wide
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </Fragment>
  <main>
    <div class="rounded-2xl border border-secondary/50 bg-primary/45 backdrop-blur-md p-5 md:p-8 shadow-2xl shadow-black/40">
    <article>
      <header class="mb-12">
        <h1 class="text-2xl md:text-3xl font-semibold text-text mb-4">
          {post.data.title}
        </h1>
        <div class="flex items-center gap-4">
          <time class="text-sm text-text-muted">
            {
              post.data.date.toLocaleDateString("en-US", {
                year: "numeric",
                month: "long",
                day: "numeric",
              })
            }
          </time>
          {
            post.data.tags && post.data.tags.length > 0 && (
              <div class="flex gap-2">
                {post.data.tags.map((tag: string) => (
                  <span
                    class="text-xs px-2 py-0.5 rounded"
                    style={`background-color: ${tagColor(tag)}33; color: ${tagColor(tag)}`}
                  >
                    {tag}
                  </span>
                ))}
              </div>
            )
          }
        </div>
      </header>

      <div
        class="[&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-text [&_h2]:mt-12 [&_h2]:mb-4
        [&_h3]:text-lg [&_h3]:font-medium [&_h3]:text-text [&_h3]:mt-8 [&_h3]:mb-3
        [&_p]:mb-6 [&_p]:leading-relaxed [&_p]:text-text
        [&_ul]:mb-6 [&_ul]:ml-6 [&_ul]:list-disc [&_ol]:mb-6 [&_ol]:ml-6 [&_ol]:list-decimal
        [&_li]:mb-2 [&_li]:text-text
        [&_strong]:font-semibold [&_strong]:text-accent
        [&_blockquote]:border-l-2 [&_blockquote]:border-accent [&_blockquote]:pl-4 [&_blockquote]:italic [&_blockquote]:text-text-muted"
      >
        <Content />
      </div>
    </article>
    </div>

    <hr class="border-secondary my-12" />

    <footer>
      <Logo />
    </footer>
  </main>
</Layout>
