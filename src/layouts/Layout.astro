---
import { Image } from "astro:assets";
import { ClientRouter } from "astro:transitions";
import avatar from "assets/avatar.jpg";
import { Logo } from "components/Logo.jsx";
import "styles/global.css";

interface Props {
  title: string;
  description?: string;
  hideNav?: boolean;
  isHomePage?: boolean;
  type?: "website" | "article";
  publishedDate?: Date;
  wide?: boolean;
}

const {
  title,
  description = "A blog by Vasisht Sankar",
  hideNav = false,
  isHomePage = false,
  type = "website",
  publishedDate,
  wide = false,
} = Astro.props;

const BLOG_NAME = "dryrun";
const canonicalURL = Astro.url.href;
const pageTitle = isHomePage ? title : `${title} - ${BLOG_NAME}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={BLOG_NAME} />
    {
      publishedDate && (
        <meta
          property="article:published_time"
          content={publishedDate.toISOString()}
        />
      )
    }

    <!-- Preload self-hosted fonts for faster rendering -->
    <link
      rel="preload"
      href="/fonts/source-sans-pro-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/source-sans-pro-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/jetbrains-mono-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <title>{pageTitle}</title>
    <ClientRouter />
  </head>
  <body class="min-h-screen">
    <div
      class:list={[
        wide ? "max-w-3xl" : "max-w-2xl",
        "mx-auto px-4 md:px-6 py-12 md:py-20 w-full",
      ]}
    >
      <header
        class="mb-16 flex justify-center"
        style="view-transition-name: marquee"
      >
        <Logo />
      </header>
      <slot />
      {
        !hideNav && (
          <footer class="mt-16 flex justify-center">
            <a
              href="/about"
              class="flex items-center gap-2 text-sm text-text-muted hover:text-accent hover:no-underline transition-colors group"
            >
              <span class="italic">by</span>
              <Image
                src={avatar}
                alt=""
                width={32}
                height={32}
                class="w-6 h-6 rounded-full object-cover border border-text-muted/40 group-hover:border-accent transition-colors"
              />
              <span>Vasisht</span>
            </a>
          </footer>
        )
      }
    </div>
    <script>
      // Moving deeper into the blog tilts down; returning to the lobby tilts up.
      document.addEventListener("astro:before-preparation", (event) => {
        event.direction = event.to.pathname === "/" ? "back" : "forward";
      });

      // Media parsed in the router's detached document fails with "no source"
      // and does not retry when it is moved into the page, so reload it.
      document.addEventListener("astro:after-swap", () => {
        document
          .querySelectorAll<HTMLMediaElement>("video, audio")
          .forEach((media) => {
            if (media.networkState === media.NETWORK_NO_SOURCE) media.load();
          });
      });

      // The logo's screen changes channel while the camera pans.
      document.addEventListener("astro:after-swap", () => {
        const logo = document.querySelector("header .group");
        if (!logo) return;
        logo.classList.add("is-tuning");
        logo.addEventListener("animationend", function done(event) {
          if ((event as AnimationEvent).animationName !== "crt-switch") return;
          logo.classList.remove("is-tuning");
          logo.removeEventListener("animationend", done);
        });
      });
    </script>
  </body>
</html>
